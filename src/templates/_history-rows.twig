{# Login history rows, shared by the board and the full page. #}
<div class="pt-hist">
  <div class="th"><span>{{ 'When'|t('portero-sso') }}</span><span>{{ 'Connection'|t('portero-sso') }}</span><span>{{ 'Who'|t('portero-sso') }}</span><span>{{ 'Result'|t('portero-sso') }}</span><span>{{ 'Why'|t('portero-sso') }}</span></div>
  {% for row in rows %}
    <div>
      <span>{{ row.date|date('d M H:i') }}</span>
      <span>{{ row.connection }}{% if row.stage == 'test' %}<span class="pt-tag">{{ 'Test'|t('portero-sso') }}</span>{% endif %}</span>
      <span class="pt-who">{{ row.maskedEmail ?? '–' }}</span>
      <span>
        {% if row.outcome == 'signed-in' %}
          <b class="pt-res ok"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="8"/><path d="M4.500 8.200l2.300 2.300 4.700-5" fill="none" stroke="#fff" stroke-width="1.800"/></svg>{{ 'Signed in'|t('portero-sso') }}</b>
        {% elseif row.outcome == 'signed-out' %}
          <b class="pt-res ok"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="8"/><path d="M4.500 8.200l2.300 2.300 4.700-5" fill="none" stroke="#fff" stroke-width="1.800"/></svg>{{ 'Signed out by {provider}'|t('portero-sso', {provider: row.connection}) }}</b>
        {% elseif row.outcome == 'warning' %}
          <b class="pt-res warn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2L1 21h22zM11 9h2v6h-2zm0 7.500h2v2h-2z"/></svg>{{ 'Warning'|t('portero-sso') }}</b>
        {% else %}
          <b class="pt-res no"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 .7l7.300 7.300L8 15.300.7 8zM7 4v5h2V4zm0 6v2h2v-2z"/></svg>{{ 'Refused'|t('portero-sso') }}</b>
        {% endif %}
      </span>
      <section class="pt-why">
        {% if row.reasonCode %}
          <strong>{{ row.explanation }}</strong>
          {% if row.fix %}<em>{{ row.fix }}</em>{% endif %}
          <code>{{ row.reasonCode }}</code>
        {% endif %}
      </section>
    </div>
  {% endfor %}
</div>
